VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
# "on" enables Pay by card via the Stripe edge functions
VITE_CARD_PAYMENTS=off

# Cloudinary: cloud name + an UNSIGNED upload preset (Settings → Upload → Upload presets)
VITE_CLOUDINARY_CLOUD_NAME=<cloud name>
VITE_CLOUDINARY_UPLOAD_PRESET=<unsigned preset name>
